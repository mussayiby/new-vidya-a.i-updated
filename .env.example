# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI tutor
GEMINI_API_KEY=
AI_API_KEY=

# Optional override for the video-analysis model fallback chain.
# The app will try the primary model first, then the fallback models.
# Only use models directly confirmed for the video-analysis endpoint.
GEMINI_VIDEO_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_VIDEO_FALLBACK_MODEL=gemini-3.5-flash

# Internal local AI4Bharat Indic-TTS service. Never expose this as VITE_ data.
INDIC_TTS_URL=http://127.0.0.1:8001
